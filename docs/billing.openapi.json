{
  "openapi": "3.0.3",
  "info": {
    "title": "BILLING synthetic provider",
    "version": "1.0.0",
    "description": "Local coding exercise provider. Fixed fixtures, independent authentication, and deterministic fault injection."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4102"
    }
  ],
  "security": [
    {
      "billingBearer": []
    }
  ],
  "paths": {
    "/billing/accounts": {
      "get": {
        "summary": "List Billing accounts",
        "description": "Ordered by externalCustomerRef ascending; nextCursor null ends traversal.",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Opaque collection-scoped cursor; pass back unchanged"
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 3,
              "minimum": 1,
              "maximum": 3
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "nextCursor"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/BillingAccount"
                      }
                    },
                    "nextCursor": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or incorrect credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Provider unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Delay in seconds",
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "/billing/accounts/by-reference/{customerRef}": {
      "get": {
        "summary": "Find a Billing account by reference",
        "description": "",
        "parameters": [
          {
            "name": "customerRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "account"
                  ],
                  "properties": {
                    "account": {
                      "$ref": "#/components/schemas/BillingAccount"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or incorrect credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Provider unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Delay in seconds",
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "404": {
            "description": "Customer or account absent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/billing/accounts/{accountId}/invoices": {
      "get": {
        "summary": "List invoices for an account",
        "description": "Ordered by issuedAt descending then invoiceId ascending across pages. Immutable fixtures; nextCursor null ends traversal. Empty history returns 200 with items [].",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Opaque collection-scoped cursor; pass back unchanged"
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 3,
              "minimum": 1,
              "maximum": 3
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "nextCursor"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Invoice"
                      }
                    },
                    "nextCursor": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or incorrect credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Provider unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Delay in seconds",
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "404": {
            "description": "Customer or account absent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Service health",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "provider"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "provider": {
                      "type": "string",
                      "enum": [
                        "billing"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/__admin/profile": {
      "post": {
        "tags": [
          "mockAdministration"
        ],
        "summary": "Set profile and reset request counters",
        "description": "Faults are deterministic per exact authenticated method and URL. See UPSTREAMS.md for behavior and 1500 ms delay.",
        "security": [
          {
            "adminKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "profile"
                ],
                "properties": {
                  "profile": {
                    "$ref": "#/components/schemas/Profile"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "profile"
                  ],
                  "properties": {
                    "profile": {
                      "$ref": "#/components/schemas/Profile"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Unknown profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/__admin/state": {
      "get": {
        "tags": [
          "mockAdministration"
        ],
        "summary": "Read profile and counters",
        "security": [
          {
            "adminKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "profile",
                    "requests"
                  ],
                  "properties": {
                    "profile": {
                      "$ref": "#/components/schemas/Profile"
                    },
                    "requests": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Profile": {
        "type": "string",
        "enum": [
          "healthy",
          "crm-timeout",
          "crm-transient",
          "billing-rate-limit",
          "billing-down"
        ]
      },
      "BillingAccount": {
        "type": "object",
        "required": [
          "accountId",
          "externalCustomerRef",
          "subscriptions"
        ],
        "properties": {
          "accountId": {
            "type": "string"
          },
          "externalCustomerRef": {
            "type": "string"
          },
          "subscriptions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Subscription"
            }
          }
        }
      },
      "Subscription": {
        "type": "object",
        "required": [
          "subscription_id",
          "plan_code",
          "lifecycle",
          "starts_at",
          "ends_at"
        ],
        "properties": {
          "subscription_id": {
            "type": "string"
          },
          "plan_code": {
            "type": "string"
          },
          "lifecycle": {
            "type": "string",
            "enum": [
              "active",
              "cancelled"
            ]
          },
          "starts_at": {
            "type": "string",
            "format": "date-time"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "Invoice": {
        "type": "object",
        "required": [
          "invoiceId",
          "accountId",
          "issuedAt",
          "dueAt",
          "currencyCode",
          "totalMinor",
          "outstandingMinor",
          "paymentAttempts"
        ],
        "properties": {
          "invoiceId": {
            "type": "string"
          },
          "accountId": {
            "type": "string"
          },
          "issuedAt": {
            "type": "string",
            "format": "date-time"
          },
          "dueAt": {
            "type": "string",
            "format": "date-time"
          },
          "currencyCode": {
            "type": "string",
            "enum": [
              "USD"
            ]
          },
          "totalMinor": {
            "type": "integer",
            "minimum": 0
          },
          "outstandingMinor": {
            "type": "integer",
            "minimum": 0
          },
          "paymentAttempts": {
            "type": "array",
            "description": "Oldest attempt first",
            "items": {
              "type": "object",
              "required": [
                "attemptedAt",
                "result"
              ],
              "properties": {
                "attemptedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "result": {
                  "type": "string",
                  "enum": [
                    "failed",
                    "succeeded"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "billingBearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "adminKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Mock-Admin-Key"
      }
    }
  }
}
